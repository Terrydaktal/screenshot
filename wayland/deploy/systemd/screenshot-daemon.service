[Unit]
Description=Screenshot daemon for KDE Plasma Wayland
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
ExecStart=__PROJECT_ROOT__/target/release/screenshot-daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
